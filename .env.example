# ============================================================
# MEESTER — omgevingsvariabelen
# Kopieer dit bestand naar ".env" en vul de waarden in.
# In Vercel zet je DEZELFDE variabelen onder:
#   Project → Settings → Environment Variables
# ============================================================

# ── Supabase (productie) ────────────────────────────────────
# Kopieer beide strings exact uit: Supabase → knop "Connect" →
# tab "Connection pooling" / "Direct connection".
#
# DATABASE_URL = Transaction pooler (poort 6543) → runtime (Vercel)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<WACHTWOORD>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# DIRECT_URL = Session pooler (poort 5432) → migrations (`prisma db push`)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<WACHTWOORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Geheime sleutel voor het tekenen van sessiecookies.
# Genereer er een met:  openssl rand -hex 32
SESSION_SECRET="plak-hier-een-lange-willekeurige-string"

# ── Optioneel: lokaal ontwikkelen zonder Supabase (SQLite) ──
# Plaats dan provider = "sqlite" in prisma/schema.prisma en gebruik:
# DATABASE_URL="file:./db/custom.db"
